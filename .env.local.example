# Copia este archivo a .env.local y llena estos valores.

# Supabase > Settings > API Keys
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=TU_ANON_KEY_AQUI

# Supabase > Settings > API Keys > pestaña "Legacy anon, service_role API keys"
# (o la nueva "secret key"). NUNCA la compartas, es privada.
SUPABASE_SERVICE_ROLE_KEY=TU_SERVICE_ROLE_KEY_AQUI

# Resend (resend.com) - para el reporte semanal por correo. Cuenta gratis.
RESEND_API_KEY=TU_RESEND_API_KEY_AQUI
REPORT_EMAIL_TO=tu-correo@ejemplo.com
REPORT_EMAIL_FROM=Gus Dive <onboarding@resend.dev>

# Cualquier texto largo y aleatorio que tú inventes, para proteger el reporte automático.
CRON_SECRET=inventate-un-texto-largo-y-aleatorio-aqui
